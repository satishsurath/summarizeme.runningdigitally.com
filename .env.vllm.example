# Local development environment
# vLLM is the LLM backend (replacing OpenAI / Ollama)
# Two separate instances: one for embeddings, one for generation
# Hosted in Docker on this machine — see docker-compose.dev.yml

DATABASE_URL=postgresql://summarizeme:summarizeme_pass@localhost:55432/summarizeme
VLLM_EMBED_HOST=localhost
VLLM_EMBED_PORT=8001
VLLM_GEN_HOST=localhost
VLLM_GEN_PORT=8000
DEV_AUTH_ENABLED=true
