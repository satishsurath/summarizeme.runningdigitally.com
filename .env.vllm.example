# vLLM development environment — local Docker instances
#
# Two separate vLLM containers run on this machine:
#   • Embeddings: nemo-nomic-embed-text-v1.5 on port 8001
#   • Generation: Qwen3.6-35B-A3B-NVFP4 on port 8000
#
# API keys must be provided from a vault or local keyring.
# Never commit literal values to version control.

DATABASE_URL=postgresql://summarizeme:summarizeme_pass@localhost:55432/summarizeme
DEV_AUTH_ENABLED=true

# Embedding endpoint (Nemo-hosted nomic-embed-text-v1.5)
VLLM_EMBED_HOST=localhost
VLLM_EMBED_PORT=8001
VLLM_EMBED_API_KEY=

# Generation endpoint (Nemo-hosted Qwen3.6-35B-A3B-NVFP4)
VLLM_GEN_HOST=localhost
VLLM_GEN_PORT=8000
VLLM_GEN_API_KEY=
