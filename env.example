# Environment variables for SummarizeMe
#
# Copy this file to .env and fill in the values.
# Never commit literal API keys to version control.

# PostgreSQL connection string
DATABASE_URL=postgresql://summarizeme:password@localhost:5432/summarizeme

# Authentication mode: "true" enables local dev auth (dev@localhost gets admin role)
DEV_AUTH_ENABLED=false

# ─── vLLM Endpoints ──────────────────────────────────────────────────
# Two separate vLLM instances: one for embeddings, one for generation.
# Set VLLM_GEN_HOST to enable vLLM mode; omit to fall back to Ollama.

# Embedding service (nomic-embed-text / nemo-nomic-embed-text-v1.5)
VLLM_EMBED_HOST=localhost
VLLM_EMBED_PORT=8001
VLLM_EMBED_API_KEY=

# Generation service (Qwen3.6-35B-A3B-NVFP4 or similar)
VLLM_GEN_HOST=localhost
VLLM_GEN_PORT=8000
VLLM_GEN_API_KEY=

# ─── Ollama Fallback ────────────────────────────────────────────────
# Only used when VLLM_*_HOST is not set.
# REMOTE_OLLAMA_HOST=localhost
