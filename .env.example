# SummarizeMe Production Environment Variables
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control.

# ---------------------------------------------------------------------------
# Database (PostgreSQL/TimescaleDB)
# ---------------------------------------------------------------------------
# Required. Format: postgresql://user:password@host:port/database
# For local dev: postgresql://summarizeme:summarizeme_pass@localhost:5432/summarizeme
# For production: Use a managed PostgreSQL service (e.g., AWS RDS, Timescale Cloud)
DATABASE_URL=postgresql://summarizeme:CHANGE_ME@db_host:5432/summarizeme

# PostgreSQL connection details (used by backup_database.py)
POSTGRES_USER=summarizeme
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=summarizeme

# ---------------------------------------------------------------------------
# vLLM Backend (generation)
# ---------------------------------------------------------------------------
# Required. vLLM instance serving the generation model.
VLLM_GEN_HOST=<vllm-host>
VLLM_GEN_PORT=8000
VLLM_GEN_API_KEY=CHANGE_ME

# ---------------------------------------------------------------------------
# vLLM Backend (embeddings)
# ---------------------------------------------------------------------------
# Required. vLLM instance serving the embedding model.
VLLM_EMBED_HOST=<vllm-host>
VLLM_EMBED_PORT=8001
VLLM_EMBED_API_KEY=CHANGE_ME

# Embedding model name (default: nemo-nomic-embed-text-v1.5)
VLLM_EMBED_MODEL=nemo-nomic-embed-text-v1.5

# ---------------------------------------------------------------------------
# Redis (task status, caching)
# ---------------------------------------------------------------------------
# Required for production. Format: redis://host:port/db
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------
# Required. Secret key for session cookies and CSRF tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# Flask environment (production)
FLASK_ENV=production

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Set to 'true' only for development. In production, use Cloudflare Access
# or another auth provider.
DEV_AUTH_ENABLED=false

# ---------------------------------------------------------------------------
# Backup Configuration
# ---------------------------------------------------------------------------
# Directory for database backups
BACKUP_DIR=./backups

# Number of days to retain backups
BACKUP_RETENTION=30
